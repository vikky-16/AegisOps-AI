# AegisOps AI Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=aegisops-super-secret-enterprise-key-2026-sre-ai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend & Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./aegisops.db

# Microservices Ports
GATEWAY_PORT=8001
SERVICE_A_PORT=8002
SERVICE_B_PORT=8003
DATABASE_SERVICE_PORT=8004
AUTH_SERVICE_PORT=8005

# ==============================================================================
# Apache Kafka Streaming Configuration
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=aegisops-processing-group
KAFKA_TOPIC_TELEMETRY=telemetry.raw
KAFKA_TOPIC_ANOMALIES=telemetry.anomalies
KAFKA_TOPIC_INCIDENTS=incidents
KAFKA_TOPIC_REMEDIATION=remediation.actions

# ==============================================================================
# OpenTelemetry Collector Configuration
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegisops-orchestrator

# Monitoring & AIOps Settings
MONITORING_INTERVAL_SEC=1.0
ANOMALY_CONTAMINATION=0.05
SLIDING_WINDOW_SEC=20
STORAGE_GROWTH_PREDICTION_HOURS=24
AUTO_HEALING_LOW_RISK=true

# ==============================================================================
# Azure Monitor / Azure Event Hubs Real-Time Production Telemetry Connector
# ==============================================================================
AZURE_MONITOR_ENABLED=false
AZURE_EVENTHUB_NAMESPACE=
AZURE_EVENTHUB_NAME=
AZURE_EVENTHUB_CONSUMER_GROUP=aegisops
AZURE_EVENTHUB_CONNECTION_STRING=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USE_MANAGED_IDENTITY=false
AZURE_BATCH_SIZE=100
AZURE_MAX_QUEUE_SIZE=5000
AZURE_RETENTION_DAYS=30
